# LLM provider API keys — set the one matching your chosen provider
# provider=claude → requires ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-...

# provider=gemini → requires GEMINI_API_KEY
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# VCS Token for Git push & Pull/Merge Request creation (GitHub PAT or GitLab Token)
# GitHub Fine-grained PAT scopes required: Contents (Read & Write), Pull requests (Read & Write)
# GitLab Token scopes required: api, write_repository
VCS_TOKEN=ghp_...

# Optional: Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: GitLab instance URL (default: https://gitlab.com)
GITLAB_URL=https://gitlab.com
